# Replicator M3 spike — knobs. Sourced by run_spike.sh (bash).
# Edit these for your box, then: bash spike/run_spike.sh

# Models to test: "label|huggingface_repo_id".
# Primary = the model we WANT to serve; the second is the confirmed-working
# fallback AND a control for the cache-reuse test (a plain transformer SHOULD
# show reuse — if it doesn't, the test harness is suspect).
# NOTE: verify these repo ids exist on HF before running (base, not Instruct).
MODELS=(
  "qwen3.5-0.8b-base|Qwen/Qwen3.5-0.8B-Base"
  "qwen3-0.6b-base|Qwen/Qwen3-0.6B-Base"
)

# Serving quantizations to benchmark (the ones we'd actually ship).
QUANTS=(Q4_K_M Q8_0)

THREADS=4                       # the CPU serve box has 4 cores

# llama-bench prefill sizes (comma list) + generation length.
CTX_LIST="512,1024,2048,3072"
NGEN=128

# Cache-reuse test (run against llama-server).
SERVER_CTX=4096                # must exceed BASE_TOKENS + a little headroom
BASE_TOKENS=1536              # size of the shared prefix; big enough that
                              # full-reprefill vs append-only is unmistakable
PORT=8080

# Per-turn PREFILL budget for the context recommendation, in seconds.
# Kept under the ~60s total reply budget (PLAN §11) to leave room for
# generation (+ optional vision). Tune to taste.
BUDGET_S=30

# Optional: point at a prebuilt llama.cpp instead of cloning/building.
#   - dir containing the binaries directly, OR
#   - a llama.cpp source dir with build/bin/.
LLAMA_CPP_DIR=""

# Where downloaded HF models + GGUFs go (git-ignored via models/).
WORK="models/spike"
# Where bench/cache JSON + the final REPORT.md are written.
RESULTS="spike/results"
